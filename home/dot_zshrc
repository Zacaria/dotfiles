# Keep machine-specific settings and secrets in ~/.zshrc.local.
export ZSH="$HOME/.oh-my-zsh"
plugins=(git history node npm sudo z)
if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
fi

DEFAULT_USER="$USER"
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt HIST_IGNORE_ALL_DUPS SHARE_HISTORY

# Preserve user-installed CLI tools; mise selects the runtimes below.
typeset -U path PATH
path=("$HOME/.local/bin" "$HOME/.cargo/bin" "$HOME/.bun/bin" "$HOME/Library/pnpm" $path)
path+=("${GOPATH:-$HOME/go}/bin")
export PATH
export EDITOR="zed --wait"
export VISUAL="$EDITOR"

[[ -r "$HOME/.aliases" ]] && source "$HOME/.aliases"
[[ -r "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"

if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

# Activate last so older runtime installations do not override mise's PATH.
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi
